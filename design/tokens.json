{
  "$metadata": {
    "tokenSetOrder": [
      "primitives",
      "color/light",
      "color/dark",
      "spacing",
      "radius",
      "size",
      "typography"
    ]
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "primitives": "source",
        "color/light": "enabled",
        "spacing": "enabled",
        "radius": "enabled",
        "size": "enabled",
        "typography": "enabled"
      }
    },
    {
      "id": "dark",
      "name": "Dark",
      "selectedTokenSets": {
        "primitives": "source",
        "color/dark": "enabled",
        "spacing": "enabled",
        "radius": "enabled",
        "size": "enabled",
        "typography": "enabled"
      }
    }
  ],

  "primitives": {
    "neutral": {
      "$type": "color",
      "0":    { "$value": "#ffffff" },
      "50":   { "$value": "#fafafa" },
      "100":  { "$value": "#f5f5f5" },
      "200":  { "$value": "#e5e5e5" },
      "300":  { "$value": "#d4d4d4" },
      "400":  { "$value": "#a3a3a3" },
      "500":  { "$value": "#737373" },
      "600":  { "$value": "#525252" },
      "700":  { "$value": "#404040" },
      "800":  { "$value": "#262626" },
      "900":  { "$value": "#171717" },
      "1000": { "$value": "#000000" }
    },

    "brand": {
      "$type": "color",
      "$description": "PLACEHOLDER abu-abu. Ganti dengan warna merek Bacain. Jangan ubah nama tokennya.",
      "100": { "$value": "#e8e8e8" },
      "300": { "$value": "#9c9c9c" },
      "500": { "$value": "#3d3d3d" },
      "700": { "$value": "#242424" },
      "900": { "$value": "#101010" }
    },

    "accent": {
      "$type": "color",
      "$description": "PLACEHOLDER abu-abu. Warna aksen sekunder — dipakai untuk highlight bacaan & bar kuota.",
      "100": { "$value": "#ededed" },
      "300": { "$value": "#b0b0b0" },
      "500": { "$value": "#5c5c5c" },
      "700": { "$value": "#333333" },
      "900": { "$value": "#1a1a1a" }
    },

    "red":   { "$type": "color", "100": { "$value": "#fbe9e7" }, "500": { "$value": "#c0392b" } },
    "amber": { "$type": "color", "100": { "$value": "#fdf3e3" }, "500": { "$value": "#b7791f" } },
    "green": { "$type": "color", "100": { "$value": "#e8f3ec" }, "500": { "$value": "#2f7a4f" } },

    "cover": {
      "$type": "color",
      "$description": "Palet sampul buku yang dibangkitkan otomatis dari judul. Buku hasil scan & sebagian besar PDF tidak punya sampul, jadi rak akan kosong tanpa ini. Delapan warna ini harus tetap enak dilihat saat berjejer.",
      "1": { "$value": "#6b7f8c" },
      "2": { "$value": "#8c7a6b" },
      "3": { "$value": "#7a8c6b" },
      "4": { "$value": "#8c6b7a" },
      "5": { "$value": "#6b6b8c" },
      "6": { "$value": "#8c8168" },
      "7": { "$value": "#68868c" },
      "8": { "$value": "#7d6b8c" }
    }
  },

  "color/light": {
    "bg": {
      "$type": "color",
      "base":          { "$value": "{primitives.neutral.50}" },
      "surface":       { "$value": "{primitives.neutral.0}" },
      "surfaceVariant":{ "$value": "{primitives.neutral.100}" },
      "scrim":         { "$value": "#00000080", "$description": "Latar gelap di belakang bottom sheet." }
    },
    "brand": {
      "$type": "color",
      "primary":   { "$value": "{primitives.brand.500}" },
      "onPrimary": { "$value": "{primitives.neutral.0}" },
      "accent":    { "$value": "{primitives.accent.500}" }
    },
    "text": {
      "$type": "color",
      "primary":   { "$value": "{primitives.neutral.900}" },
      "secondary": { "$value": "{primitives.neutral.500}" },
      "disabled":  { "$value": "{primitives.neutral.400}" },
      "onBrand":   { "$value": "{primitives.neutral.0}" }
    },
    "border": {
      "$type": "color",
      "default": { "$value": "{primitives.neutral.200}" },
      "strong":  { "$value": "{primitives.neutral.300}" }
    },
    "status": {
      "$type": "color",
      "success":   { "$value": "{primitives.green.500}" },
      "successBg": { "$value": "{primitives.green.100}" },
      "warning":   { "$value": "{primitives.amber.500}" },
      "warningBg": { "$value": "{primitives.amber.100}" },
      "error":     { "$value": "{primitives.red.500}" },
      "errorBg":   { "$value": "{primitives.red.100}" }
    },
    "reading": {
      "$type": "color",
      "$description": "Empat token paling menentukan rasa produk. WAJIB diuji langsung di layar HP, bukan di monitor.",
      "textFuture": { "$value": "{primitives.neutral.700}", "$description": "Teks yang belum dibacakan — warna baca normal." },
      "textActive": { "$value": "{primitives.neutral.1000}", "$description": "Kalimat yang sedang dibacakan." },
      "highlightBg":{ "$value": "{primitives.accent.100}", "$description": "Latar di belakang kalimat aktif." },
      "textPast":   { "$value": "{primitives.neutral.400}", "$description": "Teks yang sudah lewat — memudar." }
    },
    "progress": {
      "$type": "color",
      "filled": { "$value": "{primitives.brand.500}" },
      "track":  { "$value": "{primitives.neutral.200}" }
    },
    "quota": {
      "$type": "color",
      "filled": { "$value": "{primitives.accent.500}" },
      "track":  { "$value": "{primitives.neutral.200}" }
    },
    "player": {
      "$type": "color",
      "controlBg":   { "$value": "{primitives.brand.500}" },
      "controlIcon": { "$value": "{primitives.neutral.0}" },
      "miniBarBg":   { "$value": "{primitives.neutral.0}" }
    }
  },

  "color/dark": {
    "bg": {
      "$type": "color",
      "$description": "Base sengaja hitam pekat — app ini didengarkan menjelang tidur, dan layar OLED hemat daya di hitam murni.",
      "base":          { "$value": "{primitives.neutral.1000}" },
      "surface":       { "$value": "{primitives.neutral.900}" },
      "surfaceVariant":{ "$value": "{primitives.neutral.800}" },
      "scrim":         { "$value": "#000000b3" }
    },
    "brand": {
      "$type": "color",
      "primary":   { "$value": "{primitives.brand.300}" },
      "onPrimary": { "$value": "{primitives.neutral.1000}" },
      "accent":    { "$value": "{primitives.accent.300}" }
    },
    "text": {
      "$type": "color",
      "primary":   { "$value": "{primitives.neutral.100}" },
      "secondary": { "$value": "{primitives.neutral.400}" },
      "disabled":  { "$value": "{primitives.neutral.600}" },
      "onBrand":   { "$value": "{primitives.neutral.1000}" }
    },
    "border": {
      "$type": "color",
      "default": { "$value": "{primitives.neutral.800}" },
      "strong":  { "$value": "{primitives.neutral.700}" }
    },
    "status": {
      "$type": "color",
      "success":   { "$value": "{primitives.green.500}" },
      "successBg": { "$value": "{primitives.neutral.800}" },
      "warning":   { "$value": "{primitives.amber.500}" },
      "warningBg": { "$value": "{primitives.neutral.800}" },
      "error":     { "$value": "{primitives.red.500}" },
      "errorBg":   { "$value": "{primitives.neutral.800}" }
    },
    "reading": {
      "$type": "color",
      "$description": "Highlight di mode gelap harus JAUH lebih redup daripada di terang — latar terang di kamar gelap menyilaukan dan justru merusak fokus.",
      "textFuture": { "$value": "{primitives.neutral.300}" },
      "textActive": { "$value": "{primitives.neutral.0}" },
      "highlightBg":{ "$value": "{primitives.neutral.800}" },
      "textPast":   { "$value": "{primitives.neutral.600}" }
    },
    "progress": {
      "$type": "color",
      "filled": { "$value": "{primitives.brand.300}" },
      "track":  { "$value": "{primitives.neutral.800}" }
    },
    "quota": {
      "$type": "color",
      "filled": { "$value": "{primitives.accent.300}" },
      "track":  { "$value": "{primitives.neutral.800}" }
    },
    "player": {
      "$type": "color",
      "controlBg":   { "$value": "{primitives.brand.300}" },
      "controlIcon": { "$value": "{primitives.neutral.1000}" },
      "miniBarBg":   { "$value": "{primitives.neutral.900}" }
    }
  },

  "spacing": {
    "space": {
      "$type": "dimension",
      "0": { "$value": "0px" },
      "1": { "$value": "4px" },
      "2": { "$value": "8px" },
      "3": { "$value": "12px" },
      "4": { "$value": "16px" },
      "5": { "$value": "24px" },
      "6": { "$value": "32px" },
      "7": { "$value": "48px" },
      "8": { "$value": "64px" }
    }
  },

  "radius": {
    "radius": {
      "$type": "dimension",
      "none": { "$value": "0px" },
      "sm":   { "$value": "8px" },
      "md":   { "$value": "16px" },
      "lg":   { "$value": "24px" },
      "full": { "$value": "999px" }
    }
  },

  "size": {
    "size": {
      "$type": "dimension",
      "touchMin":    { "$value": "48px", "$description": "Target sentuh minimum Android. Jangan pernah lebih kecil." },
      "icon":        { "$value": "24px" },
      "miniPlayer":  { "$value": "64px", "$description": "Tinggi mini player — memotong bagian bawah semua layar utama." },
      "coverSm":     { "$value": "56px" },
      "coverMd":     { "$value": "96px" },
      "coverLg":     { "$value": "120px" }
    }
  },

  "typography": {
    "font": {
      "family": {
        "$type": "fontFamily",
        "ui":      { "$value": "Inter", "$description": "PLACEHOLDER. Typeface antarmuka." },
        "reading": { "$value": "Inter", "$description": "PLACEHOLDER. Typeface teks bacaan — butuh x-height besar & 1/l/I, 0/O yang mudah dibedakan. Pertimbangkan Atkinson Hyperlegible sebagai opsi aksesibilitas. WAJIB berlisensi app embedding." }
      },
      "weight": {
        "$type": "fontWeight",
        "regular":  { "$value": 400 },
        "medium":   { "$value": 500 },
        "semibold": { "$value": 600 },
        "bold":     { "$value": 700 }
      }
    },

    "UI": {
      "$type": "typography",
      "Display":     { "$value": { "fontFamily": "{typography.font.family.ui}", "fontWeight": "{typography.font.weight.bold}",     "fontSize": "32px", "lineHeight": "40px", "letterSpacing": "-0.5px" } },
      "Headline":    { "$value": { "fontFamily": "{typography.font.family.ui}", "fontWeight": "{typography.font.weight.bold}",     "fontSize": "24px", "lineHeight": "32px", "letterSpacing": "-0.25px" } },
      "Title":       { "$value": { "fontFamily": "{typography.font.family.ui}", "fontWeight": "{typography.font.weight.semibold}", "fontSize": "20px", "lineHeight": "28px", "letterSpacing": "0px" } },
      "TitleSmall":  { "$value": { "fontFamily": "{typography.font.family.ui}", "fontWeight": "{typography.font.weight.semibold}", "fontSize": "16px", "lineHeight": "24px", "letterSpacing": "0px" } },
      "Body":        { "$value": { "fontFamily": "{typography.font.family.ui}", "fontWeight": "{typography.font.weight.regular}",  "fontSize": "15px", "lineHeight": "22px", "letterSpacing": "0px" } },
      "BodySmall":   { "$value": { "fontFamily": "{typography.font.family.ui}", "fontWeight": "{typography.font.weight.regular}",  "fontSize": "13px", "lineHeight": "18px", "letterSpacing": "0px" } },
      "Label":       { "$value": { "fontFamily": "{typography.font.family.ui}", "fontWeight": "{typography.font.weight.semibold}", "fontSize": "14px", "lineHeight": "20px", "letterSpacing": "0.1px" } },
      "Caption":     { "$value": { "fontFamily": "{typography.font.family.ui}", "fontWeight": "{typography.font.weight.regular}",  "fontSize": "12px", "lineHeight": "16px", "letterSpacing": "0.2px" } }
    },

    "Reading": {
      "$type": "typography",
      "$description": "Line-height sengaja longgar (±1,65). Ini teks yang dipandangi 15 menit sambil mendengarkan — kerapatan UI biasa terlalu sesak untuk itu.",
      "Body":         { "$value": { "fontFamily": "{typography.font.family.reading}", "fontWeight": "{typography.font.weight.regular}",  "fontSize": "19px", "lineHeight": "32px", "letterSpacing": "0px" } },
      "BodyLarge":    { "$value": { "fontFamily": "{typography.font.family.reading}", "fontWeight": "{typography.font.weight.regular}",  "fontSize": "22px", "lineHeight": "36px", "letterSpacing": "0px" } },
      "ChapterTitle": { "$value": { "fontFamily": "{typography.font.family.reading}", "fontWeight": "{typography.font.weight.semibold}", "fontSize": "24px", "lineHeight": "32px", "letterSpacing": "-0.25px" } },
      "Recap":        { "$value": { "fontFamily": "{typography.font.family.reading}", "fontWeight": "{typography.font.weight.regular}",  "fontSize": "18px", "lineHeight": "30px", "letterSpacing": "0px" } }
    }
  }
}
