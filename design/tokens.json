  "typography": {
    "font": {
      "family": {
        "$type": "fontFamily",
        "ui": {
          "$value": "Plus Jakarta Sans",
          "$description": "Antarmuka. Dirancang Tokotype (foundry Indonesia), awalnya untuk identitas Pemprov DKI Jakarta — typeface Indonesia untuk app Indonesia, dan kebetulan memang humanist hangat. OFL, aman di-embed."
        },
        "reading": {
          "$value": "Literata",
          "$description": "Teks bacaan & judul. Dibuat Google khusus untuk membaca panjang di layar (dipakai Google Play Books) — bukan sans yang dipaksa jadi font baca. OFL, aman di-embed."
        },
        "a11y": {
          "$value": "Atkinson Hyperlegible",
          "$description": "Opsi yang bisa dipilih user di Pengaturan. Dirancang Braille Institute untuk low vision — huruf yang mirip (1/l/I, 0/O) sengaja dibedakan bentuknya. Ini yang membuat klaim aksesibilitas jadi nyata, bukan sekadar disebut."
        }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": {
          "$value": 400
        },
        "medium": {
          "$value": 500
        },
        "semibold": {
          "$value": 600
        },
        "bold": {
          "$value": 700
        }
